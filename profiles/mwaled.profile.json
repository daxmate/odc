{
  "schema_version": "odc.profile/v0",
  "profile_id": "mwaled.en",
  "spec": {
    "version": "odc-html-spec/0.1",
    "slot_registry": "odc-slots/0.1"
  },
  "dict": {
    "name": "Merriam-Webster's Advanced Learner's English Dictionary",
    "edition": "2nd",
    "lang": "en",
    "variant": "en",
    "source": {
      "format": "mdx",
      "records": 202,
      "aliases": 111,
      "entries": 91
    }
  },
  "fingerprint": {
    "algorithm": "odc-fingerprint/1",
    "sha256": "c1c3c16335c8e981d40e21ee5aa900f0029d07fcead8f2b77ca970256639d0ed",
    "samples": 91,
    "tag_histogram": {
      "a": 126,
      "div": 2462,
      "em": 425,
      "h2": 80,
      "head": 91,
