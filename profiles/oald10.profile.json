  "rules": [
    {
      "id": "cleanup.head",
      "stage": "cleanup",
      "priority": 100,
      "op": "drop",
      "match": {
        "selector": "base, link, script, style, meta"
      },
      "rationale": "OALD10 records embed a full document head; base/link/script/style/meta carry no entry text. <title> is kept because the contract bag includes it."
    },
    {
      "id": "cleanup.noise",
      "stage": "cleanup",
      "priority": 95,
      "op": "drop",
      "match": {
        "selector": "input, button, noscript, iframe, audio, video"
      },
      "rationale": "Radio inputs and widget buttons hold no text; audio/video elements are placeholder-only."
    },
    {
      "id": "cleanup.attrs",
      "stage": "cleanup",
      "priority": 90,
      "op": "drop",
      "match": {
        "selector": "*"
      },
      "rationale": "L1 keeps only allowlisted attributes; data-odc-* is re-added by later rules.",
      "attributes": [
        "style",
        "name",
        "type",
        "value",
        "for",
        "on*",
        "data-*",
        "aria-*",
        "tabindex",
        "content",
        "role",
        "hmhtml",
        "charset",
        "rel",
        "checked",
        "focusable",
        "viewbox",
        "points",
        "stroke*",
        "fill*",
        "cx",
        "cy",
        "r",
        "d",
        "transform",
        "x",
        "y",
        "rx",
        "x1",
        "y1",
        "x2",
        "y2",
        "font*"
      ]
    },
    {
      "id": "root.entry",
      "stage": "root",
      "priority": 100,
      "op": "map",
      "match": {
        "selector": "main.oald-entry",
        "cardinality": {
          "min": 1
        }
      },
      "emit": {
        "element": "section",
        "classes": [
          "odc-entry"
        ],
        "move": "children",
        "data": {
          "odc-dict": "@dict",
          "odc-key": "@key",
          "odc-lang": "@lang"
        }
      },
      "rationale": "One record = one main.oald-entry (plain, phrase or supplemental); its class triple becomes data-odc-dict/key/lang. P0 measurement: the rule matches 51310/51310 records (100.000%), so every record must carry the slot; min 1."
    },
    {
      "id": "split.pos-switch",
      "stage": "split",
      "priority": 100,
      "op": "unwrap",
      "match": {
        "selector": "div.o-pos-switch"
      },
      "rationale": "Pure layout wrapper (radios + tab labels + panels); flatten so panels are direct children."
    },
    {
      "id": "split.pos-panels",
      "stage": "split",
      "priority": 99,
      "op": "unwrap",
      "match": {
        "selector": "div.o-pos-panels"
      },
      "rationale": "Pure layout wrapper around the POS panels; flatten."
    },
    {
      "id": "slot.pos-block",
      "stage": "slot",
      "priority": 100,
      "op": "map",
      "match": {
        "selector": "section.o-pos.o-pos-panel",
        "cardinality": {
          "min": 0
        }
      },
      "emit": {
        "element": "section",
        "classes": [
          "odc-pos-block"
        ],
        "move": "children",
        "data": {
          "odc-pos": "pos"
        }
      },
      "rationale": "Each section.o-pos panel is one POS block; data-odc-pos is fixed because the engine cannot copy the tab label into an attribute. P0 measurement: the rule matches 51309/51310 records (99.998%), so the slot is optional on the rest; min 0."
    },
